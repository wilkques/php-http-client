{
    "name": "wilkques/http-client",
    "description": "http-client",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=5.3",
        "ext-json": "*",
        "ext-curl": "*",
        "wilkques/php-helper": "^6.1.0"
    },
    "autoload": {
        "files": [
            "src/JsonSerializable.php"
        ],
        "psr-4": {
            "Wilkques\\Http\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Wilkques\\Http\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "*"
    },
    "config": {
        "preferred-install": {
            "*": "dist"
        }
    }
}